# Local Docker Compose configuration. Copy this file to .env before starting the stack.
# Do not commit your real .env or put production credentials in this sample.

# MySQL root password shared by the local service databases.
MYSQL_ROOT_PASSWORD=root

# ── Gửi mail thật qua Gmail (thay cho Mailpit) ──
# Dùng cho notification-service (mail vé, đơn hàng) và Keycloak (xác minh email, quên mật khẩu).
# MAIL_PASSWORD là App Password 16 ký tự tạo ở https://myaccount.google.com/apppasswords, KHÔNG phải mật khẩu Gmail.
# Muốn quay lại Mailpit: xóa hoặc comment các dòng MAIL_* này.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
#lưu ý: MAIL_USERNAME với mail_form giống nhau


# Optional VNPay sandbox credentials. Leave empty to disable payments.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/checkout/result
