# Local Docker Compose configuration. Copy this file to .env before starting the stack.
# Do not commit your real .env or put production credentials in this sample.

# MySQL root password shared by the local service databases.
MYSQL_ROOT_PASSWORD=root

# Mailpit is included in docker-compose.yml and captures mail at http://localhost:8025.
# For real SMTP, set the host, port, credentials, auth/TLS flags, and sender address.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@eventhub.local

# Optional VNPay sandbox credentials. Leave empty to disable payments.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/checkout/result
