{
  "realm": "eventhub",
  "displayName": "EventHub",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi",
    "en"
  ],
  "defaultLocale": "vi",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 604800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Khách hàng mua vé (gán mặc định khi đăng ký)"
      },
      {
        "name": "ORGANIZER",
        "description": "Ban tổ chức sự kiện"
      },
      {
        "name": "ADMIN",
        "description": "Quản trị hệ thống"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-eventhub",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "CUSTOMER",
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-eventhub",
    "description": "${role_default-roles}",
    "composite": true
  },
  "clients": [
    {
      "clientId": "eventhub-frontend",
      "name": "EventHub Frontend",
      "description": "Next.js frontend: đăng nhập qua trang Keycloak (Authorization Code + PKCE). Direct access grant chỉ bật cho dev để lấy token nhanh khi test API.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*"
      }
    },
    {
      "clientId": "eventhub-auth-service",
      "name": "EventHub Auth Service",
      "description": "Client confidential của auth-service: password grant cho /api/v1/auth/login, refresh/logout, và service account gọi Admin API để tạo user. Secret chỉ dành cho dev.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "eventhub-auth-service-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email",
        "web-origins",
        "acr",
        "kc-admin-api"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    }
  ],
  "users": [
    {
      "username": "admin@eventhub.local",
      "email": "admin@eventhub.local",
      "firstName": "Admin",
      "lastName": "EventHub",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin@123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "offline_access",
        "uma_authorization"
      ]
    },
    {
      "username": "organizer@eventhub.local",
      "email": "organizer@eventhub.local",
      "firstName": "Organizer",
      "lastName": "EventHub",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Organizer@123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ORGANIZER",
        "offline_access",
        "uma_authorization"
      ]
    },
    {
      "username": "customer@eventhub.local",
      "email": "customer@eventhub.local",
      "firstName": "Customer",
      "lastName": "EventHub",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Customer@123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-eventhub"
      ]
    },
    {
      "username": "service-account-eventhub-auth-service",
      "enabled": true,
      "serviceAccountClientId": "eventhub-auth-service",
      "realmRoles": [
        "offline_access"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ]
}
